	)
	(paper "A4")
	(layers
		(0 "F.Cu" signal)
		(2 "B.Cu" mixed)
		(9 "F.Adhes" user "F.Adhesive")
		(11 "B.Adhes" user "B.Adhesive")
		(13 "F.Paste" user)
		(15 "B.Paste" user)
