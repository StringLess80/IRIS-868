(version 1)

(rule "RF feedline coplanar gap"
    (layer "F.Cu")
    (condition "A.NetName == 'ANT'")
    (constraint clearance (min 0.15mm) (opt 0.15mm))
)

(rule "RF feedline coplanar gap (B side)"
    (layer "F.Cu")
    (condition "B.NetName == 'ANT'")
    (constraint clearance (min 0.15mm) (opt 0.15mm))
)
